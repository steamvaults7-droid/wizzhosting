# ===== Web App (frontend) =====
# These are already set — don't change them
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== Node Agent (runs on your computer) =====
# Copy this section to node-agent/.env
# You need the SERVICE ROLE KEY — find it in your Supabase dashboard:
# Settings > API > service_role key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: customize your node
NODE_NAME=my-computer
NODE_PORT=31337
SERVERS_DIR=~/.cubeforge/servers
